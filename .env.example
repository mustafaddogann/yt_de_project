GCP_PROJECT_ID=your-youtube-dev-project
GCS_LANDING_BUCKET=your-globally-unique-youtube-dev-landing
BQ_LOCATION=US
# Run gcloud auth application-default login; mount its ADC file, not a committed key.
GCP_ADC_PATH=/absolute/path/to/application_default_credentials.json
AIRFLOW_UID=50000
# Leave empty for documented development mode; set Terraform outputs for strict runtime separation.
INGESTION_SERVICE_ACCOUNT=
TRANSFORMATION_SERVICE_ACCOUNT=
MAXIMUM_BYTES_BILLED=1000000000
